# 统一换行符与二进制标记
# 代码统一 LF，Windows 批处理保留 CRLF

* text=auto

# 文本文件显式声明（LF）
*.md text eol=lf
*.json text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.toml text eol=lf
*.ini text eol=lf

# Capacitor / Android 原生工程
*.java text eol=lf
*.gradle text eol=lf
*.xml text eol=lf
*.pro text eol=lf
gradlew text eol=lf

# Windows 批处理（CRLF）
*.bat text eol=crlf
*.cmd text eol=crlf
gradlew.bat text eol=crlf

# 二进制文件
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.exe binary
*.dll binary
*.node binary
*.jar binary
*.keystore binary
*.jks binary
*.apk binary
*.aab binary
*.onnx binary
*.pth binary
