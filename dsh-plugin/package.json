{
  "name": "dsh-hotboard",
  "version": "0.2.0",
  "description": "DSH 热榜侧边栏 Tab——通过 better-sidebar 的 ctx.betterSidebar.registerTab 注册「🔥 热榜」页，Tab 内 iframe 嵌入 Mini_hot 热榜",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "cordis": "^4.0.0-rc.7",
    "dsh-better-sidebar": "0.12.3",
    "react": "18.3.1"
  },
  "peerDependenciesMeta": {
    "cordis": {
      "optional": true
    },
    "dsh-better-sidebar": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "license": "MIT"
}
